# Production. In CI (EAS Build), these are overridden by the `production`
# build profile's `env` block in eas.json, sourced from EAS secrets —
# this file is the local fallback / documentation of what's required.
# NEVER put real secret values (SENTRY_DSN auth tokens, etc.) directly in
# this file if it's ever committed with real prod values; prefer EAS secrets.

API_BASE_URL=https://api.parkconnect.app
SCAN_BASE_URL=https://parkconnect.app/vehicle

USE_MOCK=false

SENTRY_DSN=
FCM_SENDER_ID=
EAS_PROJECT_ID=
