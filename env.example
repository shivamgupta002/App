# Copy this to .env.development / .env.staging / .env.production and fill
# in real values. Only .env.example is committed — the others are gitignored
# (see .gitignore: ".env*.local" is already ignored; add ".env.development",
# ".env.staging", ".env.production" explicitly below since they contain
# environment-specific, if not always secret, values).

# Base URL of the FastAPI backend this app talks to.
API_BASE_URL=

# Base URL used to build the QR "scan" deep link / web fallback
# (see qr_service.py's FRONTEND_URL + /vehicle/{token} on the backend —
# SCAN_BASE_URL should match that shape on the client).
SCAN_BASE_URL=

# "true" to force mock mode (src/api/client.ts USE_MOCK), "false" otherwise.
USE_MOCK=false

# Sentry DSN for crash/error reporting (Phase 9). Leave blank to disable.
SENTRY_DSN=

# Firebase Cloud Messaging sender ID (Phase 4 push notifications).
FCM_SENDER_ID=

# EAS project id from `eas init` — required for eas.json / expo-updates.
EAS_PROJECT_ID=
