# Local development. Not committed with real secrets — this file's values
# are all non-secret (local URLs, a public Sentry DSN if you have one).
# Loaded by app.config.js when APP_ENV=development (the default).

#  10.191.14.168

API_BASE_URL=http://10.191.14.168:8000
# SCAN_BASE_URL=http://10.191.14.168:3000
SCAN_BASE_URL=http://10.191.14.168:8081

# Set to "true" to force mock mode regardless of backend availability
# (e.g. offline demo, UI work with no backend running).
USE_MOCK=false

# Leave blank locally unless you want dev crashes reported.
SENTRY_DSN=

# Firebase Cloud Messaging sender ID (Phase 4 push notifications).
FCM_SENDER_ID=

# Fill in after `eas init`; needed for expo-updates URL + EAS commands.
EAS_PROJECT_ID=
